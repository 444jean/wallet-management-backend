generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  // Explicit: with tsconfig "bundler" Prisma would infer extensionless
  // imports, which Node ESM cannot load (T05).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth (core schema: user, session, account, verification)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// Brand palette (T08): purple | red | pink | green | amber.
  palette       String   @default("purple")
  /// light | dark; null = follow the device.
  theme         String?
  /// Set by the twoFactor plugin once TOTP is verified (T02 3b).
  twoFactorEnabled Boolean? @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  transactions Transaction[]
  goals        SavingsGoal[]
  salary       SalaryConfig?
  avatar       UserAvatar?
  creditCards  CreditCard[]

  @@map("user")
}

/// Profile picture (T12): 256x256 image cropped in the browser, served only
/// to its owner by GET /api/me/avatar.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  @@map("user_avatar")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth twoFactor plugin (T02 3b): TOTP secret and backup codes, both
/// encrypted with BETTER_AUTH_SECRET by the plugin.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// false until the first TOTP code is verified.
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// Global API rate limit (@nestjs/throttler, T03). One row per tracker+route
/// window, shared by every server instance. Written with raw SQL by
/// src/common/prisma-throttler.storage.ts.
model ApiRateLimit {
  key          String    @id
  hits         Int
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("api_rate_limit")
}

/// Better Auth rate limit counters (rateLimit.storage = "database", T02).
/// Shared by every server instance, unlike the in-memory default.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Epoch milliseconds of the window's last request.
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Wallet domain
// Amounts are whole CLP (no decimals), stored as Int.
// ---------------------------------------------------------------------------

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  salary
}

model Transaction {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int
  category    String
  description String
  date        DateTime           @db.Date
  source      TransactionSource?
  /// "YYYY-MM" for auto-generated salary rows; guarantees one salary per month.
  salaryMonth String?
  goalId      String?
  goal        SavingsGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, salaryMonth])
  @@index([userId, date])
  @@index([goalId])
  @@map("transactions")
}

model SavingsGoal {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  /// null = "Fondo": savings without a target amount (T10).
  target              Int?
  current             Int           @default(0)
  monthlyContribution Int           @default(0)
  /// Annual percentage rate, e.g. 4 = 4%.
  annualRate          Float         @default(0)
  deadline            DateTime?     @db.Date
  /// Where it is kept: a code from src/goals/institutions.ts (T11).
  institution         String?
  contributions       Transaction[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@map("savings_goals")
}

/// Credit card (T15): limit and billing days. Installments, used limit and the
/// monthly simulation are computed in the frontend (src/lib/credit.ts).
model CreditCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Issuing bank: a code from src/goals/institutions.ts.
  institution String?
  /// Total credit limit ("cupo"), whole CLP.
  creditLimit Int
  /// Statement closing day of the month (1-31).
  closingDay  Int
  /// Payment due day of the month (1-31).
  paymentDay  Int
  purchases   CreditCardPurchase[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("credit_cards")
}

/// A purchase paid in installments on a credit card (T15). Not a transaction:
/// the monthly card payment is recorded by the user as a normal expense.
model CreditCardPurchase {
  id           String     @id @default(cuid())
  cardId       String
  card         CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description  String
  /// Price of the purchase, before interest.
  amount       Int
  /// Number of installments (1-60).
  installments Int
  /// Monthly interest rate in percent; 0 = interest-free.
  monthlyRate  Float      @default(0)
  date         DateTime   @db.Date
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cardId])
  @@map("credit_card_purchases")
}

model SalaryConfig {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  category    String
  description String
  /// Day of month the salary is paid (capped to the month's last day).
  day         Int
  /// First month to generate, "YYYY-MM".
  since       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("salary_configs")
}
